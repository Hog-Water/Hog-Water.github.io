{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hog-water.github.io/BorkBorg/schemas/make-a-fool-catalog-v1.json",
  "title": "BORK BORG MAKE A FOOL generated catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "sources", "tables"],
  "properties": {
    "format": { "const": "bork-borg.make-a-fool.catalog.v1" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "tables": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/table" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^manuscript/content/" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sourceSha256", "die", "columns", "results"],
      "properties": {
        "source": { "type": "string", "pattern": "^manuscript/content/" },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "die": { "type": "string", "enum": ["d4", "d6", "d8", "d10", "d12", "d20", "d66", "d100"] },
        "columns": { "type": "integer", "minimum": 1 },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/result" }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "values"],
      "properties": {
        "key": { "type": "integer", "minimum": 1 },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  }
}
